# ============================================================================
# WORLD NEWS — Variables d'environnement
# Copier ce fichier en ".env" et renseigner les valeurs réelles.
# Ne jamais committer le fichier ".env" (voir .gitignore).
# ============================================================================

# --- Base de données ---------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/world_news?schema=public"

# --- Authentification (Auth.js) ----------------------------------------------
AUTH_SECRET="générer avec: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Stockage médias ----------------------------------------------------------
# Valeurs possibles: cloudinary | r2 | s3
STORAGE_PROVIDER="cloudinary"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET_NAME=""

# --- Email transactionnel ------------------------------------------------------
# Valeurs possibles: resend | smtp
EMAIL_PROVIDER="resend"
EMAIL_FROM="World News <no-reply@world-news.com>"

RESEND_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Analytics (optionnel, l'admin ne dépend pas obligatoirement de ceci) -----
GOOGLE_ANALYTICS_ID=""
MATOMO_URL=""
MATOMO_SITE_ID=""

# --- Application ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="World News"

# --- Sécurité ---------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"
